{
  "name": "playwright-qa-portfolio",
  "version": "1.0.0",
  "description": "End-to-end UI and API test automation with Playwright and TypeScript",
  "author": "Sai Sree Kodali",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
